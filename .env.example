# Copy this file to .env and fill in your real key.
# NEVER commit .env to git — only .env.example belongs in source control.

# Get your free VirusTotal API key at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Get your free URLhaus Auth-Key at: https://urlhaus-api.abuse.ch/ (click "Get API key")
URLHAUS_AUTH_KEY=your_urlhaus_auth_key_here
