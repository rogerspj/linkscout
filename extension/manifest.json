{
  "manifest_version": 3,
  "name": "LinkScout",
  "version": "1.0",
  "description": "Right-click any link to check it for threats before you click.",

  "permissions": [
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "http://18.144.144.119/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
